# Copy the exact SMTP host from Zoho Mail > Settings > Mail Accounts > SMTP.
# US paid domain accounts commonly use smtppro.zoho.com; free accounts smtp.zoho.com.
# Regional accounts may have another suffix. Confirm in your own Zoho settings.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=contact@oraclesteps.com
NUXT_SMTP_PASSWORD=
